# ===================================================
# DOI KOI — Environment Configuration
# ===================================================

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="DOI KOI"
NEXT_PUBLIC_TAGLINE="Bogura at your doorsteps"

# Admin Authentication
ADMIN_EMAIL=admin@doikoi.com
# Session secret for signing admin auth tokens. REQUIRED - the app refuses to
# start without it. Generate your own, never reuse a value from a real deploy:
#   openssl rand -hex 32
ADMIN_AUTH_SECRET=

# Supabase (Optional for Cloud Production Deployment)
# When set, the system connects directly to your cloud Supabase database & storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Bangladeshi Payment Gateways (Ready for activation)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# Notification / SMS Gateway (Optional)
SMS_API_KEY=
SMS_SENDER_ID=
